# --- Base de données -------------------------------------------------------
# Neon (injectée automatiquement par l'intégration Vercel Marketplace).
# Laisser VIDE en local : l'application utilise alors PGlite (.data/pglite),
# migré automatiquement. Obligatoire en production.
DATABASE_URL=

# --- Authentification (Better Auth) -----------------------------------------
# Secret de signature des sessions : openssl rand -base64 32
BETTER_AUTH_SECRET=
# URL publique du site (en local : http://localhost:3000)
BETTER_AUTH_URL=http://localhost:3000

# --- Fichiers des cartes (Vercel Blob) --------------------------------------
# Créé par Vercel (Storage → Blob). Laisser VIDE en local : les fichiers sont
# alors écrits dans public/uploads (ignoré par git).
BLOB_READ_WRITE_TOKEN=

# --- Site -------------------------------------------------------------------
# URL publique, utilisée dans les liens des mails (https://www.latelierdelecharpe.fr en prod).
# À défaut, BETTER_AUTH_URL est utilisée.
SITE_URL=http://localhost:3000

# --- Mails (Nodemailer + SMTP IONOS) ----------------------------------------
# Boîte reservations@latelierdelecharpe.fr créée chez IONOS.
# Laisser SMTP_HOST vide en local : les mails s'affichent dans la console.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=reservations@latelierdelecharpe.fr
SMTP_PASSWORD=
# Expéditeur affiché (facultatif ; par défaut « L'Atelier de l'Écharpe » <SMTP_USER>)
SMTP_FROM=
# Boîte qui reçoit les demandes de réservation
MAIL_TO_RESTAURANT=
